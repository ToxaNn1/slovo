{
  "extends": "@slovo/config/tsconfig.base.json",
  "compilerOptions": {
    // No DOM lib: `src/fetch-types.d.ts` declares the web platform's request types the API
    // contract's client names, as types only, and ESLint bans the browser's and the network's globals.
    "lib": ["ES2023"],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": ["src"],
  "references": [{ "path": "../contracts" }]
}
