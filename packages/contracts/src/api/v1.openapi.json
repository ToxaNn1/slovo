    "/v1/editions/{editionId}/content/latest": {
      "get": {
        "operationId": "content.latest",
        "summary": "The newest published Language Pack the app can read",
        "tags": [
          "content"
        ],
        "parameters": [
          {
            "name": "editionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          {
            "name": "packFormat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "exclusiveMinimum": 0
            },
            "allowEmptyValue": true,
            "allowReserved": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "pack": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "contentVersion": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991,
                              "exclusiveMinimum": 0
                            },
                            "packFormat": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991,
                              "exclusiveMinimum": 0
                            },
                            "size": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991,
                              "exclusiveMinimum": 0
                            },
                            "fileSha256": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            }
                          },
                          "required": [
                            "contentVersion",
                            "packFormat",
                            "size",
                            "fileSha256"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "pack"
