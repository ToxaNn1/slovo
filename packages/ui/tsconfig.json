{
  "extends": "@slovo/config/tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "jsx": "react-jsx",
    // Resolve platform files the way Metro does for the native app.
    "moduleSuffixes": [".ios", ".native", ""],
    // The tests read the package's files through Node.
    "types": ["node"]
  },
  "include": ["src"],
  "references": [
    {
      "path": "../contracts"
    },
    {
      "path": "../core"
    }
  ]
}
