{
  "name": "@slovo/language-pack",
  "version": "0.0.0",
  "private": true,
  "description": "Builds an Edition's content into a read-only SQLite Language Pack, and reads packs in Node or through any SQLite driver.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./reader": "./src/pack-reader.ts"
  },
  "scripts": {
    "build-pack": "tsx --disable-warning=ExperimentalWarning src/cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@slovo/contracts": "workspace:*",
    "@slovo/core": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@slovo/config": "workspace:*",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
