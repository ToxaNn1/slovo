{
  "name": "@slovo/language-pack",
  "version": "0.0.0",
  "private": true,
  "description": "Builds an Edition's content into a read-only SQLite Language Pack, and reads packs in Node or through any SQLite driver.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./edition": "./src/edition-folder.ts",
    "./reader": "./src/pack-reader.ts"
  },
  "scripts": {
    "build-pack": "tsx --disable-warning=ExperimentalWarning src/cli.ts",
    "recording-requests": "tsx --disable-warning=ExperimentalWarning src/recording-requests-cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@slovo/content-rules": "workspace:*",
    "@slovo/contracts": "workspace:*",
    "@slovo/core": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@slovo/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
