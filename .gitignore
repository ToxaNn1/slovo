.DS_Store
node_modules/
.env
.env.*
!.env.example

# Build and tool output
dist/
coverage/
*.tsbuildinfo
.turbo/

# Sourcing tool: the HTTP cache and the drafts awaiting review
tools/sourcing/.cache/
tools/sourcing/review/

# The widget extension's Edition files, written by the prebuild (apps/mobile/plugins/widget-extension.ts)
apps/widget/Info.plist
apps/widget/Generated/

# The native iOS project, made by `expo prebuild` in the Maestro workflow (ADR 0004)
apps/mobile/ios/

# Agent settings of one machine (hooks, permissions); the shared ones are committed
.claude/settings.local.json

# The private code-signing key of OTA updates lives in EAS only (ADR 0062).
private-key.pem
