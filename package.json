{
  "name": "slovo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:pack": "pnpm --filter @slovo/language-pack build-pack",
    "publish:pack": "pnpm --filter @slovo/backend publish-pack",
    "switch:off": "pnpm --filter @slovo/backend switch-off",
    "switch:clear": "pnpm --filter @slovo/backend switch-clear",
    "reports": "pnpm --filter @slovo/backend reports",
    "collection-links": "pnpm --filter @slovo/backend collection-links",
    "describe:api": "pnpm --filter @slovo/contracts describe-api",
    "source:words": "pnpm --filter @slovo/sourcing source-words",
    "content": "pnpm --filter @slovo/content content",
    "smoke:halves": "node scripts/smoke-halves.mjs",
    "lint": "oxlint && turbo run lint && prettier --check .",
    "typecheck": "turbo run typecheck",
    "deps": "depcruise apps packages tools editions --config .dependency-cruiser.mjs && depcruise apps/mobile/src packages/core/src packages/ui/src --config .dependency-cruiser.folders.mjs",
    "test": "turbo run test --concurrency=1",
    "format": "prettier --write .",
    "commitlint": "commitlint",
    "knip": "SLOVO_EDITION=uk knip"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@slovo/config": "workspace:*",
    "dependency-cruiser": "^18.7.0",
    "knip": "^6.42.1",
    "oxlint": "~1.89.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
