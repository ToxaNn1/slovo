{
  "name": "slovo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:pack": "pnpm --filter @slovo/language-pack build-pack",
    "publish:pack": "pnpm --filter @slovo/backend publish-pack",
    "switch:off": "pnpm --filter @slovo/backend switch-off",
    "switch:clear": "pnpm --filter @slovo/backend switch-clear",
    "describe:api": "pnpm --filter @slovo/contracts describe-api",
    "source:words": "pnpm --filter @slovo/sourcing source-words",
    "lint": "oxlint && turbo run lint && prettier --check .",
    "typecheck": "turbo run typecheck",
    "deps": "depcruise apps packages tools editions --config .dependency-cruiser.mjs",
    "test": "turbo run test",
    "format": "prettier --write .",
    "knip": "SLOVO_EDITION=uk knip"
  },
  "devDependencies": {
    "@slovo/config": "workspace:*",
    "dependency-cruiser": "^18.6.0",
    "knip": "^6.41.0",
    "oxlint": "~1.88.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "~6.0.3"
  }
}
