{
  "name": "slovo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:admin": "pnpm --filter @slovo/admin dev",
    "build:pack": "pnpm --filter @slovo/language-pack build-pack",
    "switches": "pnpm --filter @slovo/backend switches",
    "admin": "pnpm --filter @slovo/backend admin",
    "cron": "pnpm --filter @slovo/backend cron",
    "reports": "pnpm --filter @slovo/backend reports",
    "collection-links": "pnpm --filter @slovo/backend collection-links",
    "describe:api": "pnpm --filter @slovo/contracts describe-api",
    "source:words": "pnpm --filter @slovo/sourcing source-words",
    "source:idioms": "pnpm --filter @slovo/sourcing source-idioms",
    "source:corrections": "pnpm --filter @slovo/sourcing source-corrections",
    "source:synonyms": "pnpm --filter @slovo/sourcing source-synonyms",
    "content": "pnpm --filter @slovo/content content",
    "smoke:halves": "node scripts/smoke-halves.mjs",
    "lint": "oxlint && turbo run lint && prettier --check .",
    "typecheck": "turbo run typecheck && tsc -p .railway",
    "deps": "depcruise apps packages tools editions --config .dependency-cruiser.mjs && depcruise apps/mobile/src packages/core/src packages/ui/src --config .dependency-cruiser.folders.mjs && node scripts/core-exports.mjs",
    "test": "turbo run test --concurrency=50%",
    "verify": "oxlint --quiet && TURBO_SCM_BASE=origin/main turbo run lint typecheck test --affected --concurrency=50% --output-logs=errors-only && pnpm --silent deps && prettier --check . --log-level warn",
    "format": "prettier --write .",
    "commitlint": "commitlint",
    "knip": "knip"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@slovo/config": "workspace:*",
    "dependency-cruiser": "^18.7.2",
    "knip": "^6.44.1",
    "oxlint": "~1.91.0",
    "prettier": "^3.9.10",
    "railway": "3.16.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
