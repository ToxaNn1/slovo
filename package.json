{
  "name": "slovo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build:pack": "pnpm --filter @slovo/language-pack build-pack",
    "lint": "turbo run lint && prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@slovo/config": "workspace:*",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~7.0.2"
  }
}
