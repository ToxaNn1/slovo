{
  "name": "@slovo/content",
  "version": "0.0.0",
  "private": true,
  "description": "Dev-only CLI: a thin client of the content write API, which checks drafts with the shared content rules and verifies their quotes.",
  "type": "module",
  "scripts": {
    "content": "tsx --disable-warning=ExperimentalWarning src/cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@slovo/content-rules": "workspace:*",
    "@slovo/contracts": "workspace:*",
    "@slovo/language-pack": "workspace:*",
    "@slovo/sourcing": "workspace:*"
  },
  "devDependencies": {
    "@slovo/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
