{
  "name": "@slovo/sourcing",
  "version": "0.0.0",
  "private": true,
  "description": "Dev-only tool that drafts Words from dictionary sources (СУМ-11 on sum.in.ua, goroh.pp.ua) for human review, and picks Word candidates from an open headword list.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "source-words": "tsx --disable-warning=ExperimentalWarning src/cli.ts",
    "source-idioms": "tsx --disable-warning=ExperimentalWarning src/cli-idioms.ts",
    "source-corrections": "tsx --disable-warning=ExperimentalWarning src/cli-corrections.ts",
    "source-synonyms": "tsx --disable-warning=ExperimentalWarning src/cli-synonyms.ts",
    "source-lemmas": "tsx --disable-warning=ExperimentalWarning src/cli-lemmas.ts",
    "source-hrinchenko": "tsx --disable-warning=ExperimentalWarning src/cli-hrinchenko.ts",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@slovo/content-rules": "workspace:*",
    "@slovo/contracts": "workspace:*",
    "@slovo/language-pack": "workspace:*",
    "node-html-parser": "^9.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@slovo/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
