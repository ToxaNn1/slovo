{
  "name": "@slovo/backend",
  "version": "0.0.0",
  "private": true,
  "description": "The backend shell: HTTP, the adapters of the server Core's ports and one composition root.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/database/migrate-command.ts",
    "publish-pack": "tsx --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/content/publish-command.ts",
    "switch-off": "tsx --env-file-if-exists=.env src/edition/switch-command.ts off",
    "switch-clear": "tsx --env-file-if-exists=.env src/edition/switch-command.ts clear",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@orpc/openapi": "^1.16.0",
    "@orpc/server": "^1.16.0",
    "@sentry/node": "^11.8.0",
    "@slovo/contracts": "workspace:*",
    "@slovo/language-pack": "workspace:*",
    "@slovo/server-core": "workspace:*",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "nodemailer": "^10.2.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@slovo/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
