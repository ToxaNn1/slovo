{
  "name": "@slovo/backend",
  "version": "0.0.0",
  "private": true,
  "description": "The backend shell: HTTP, the adapters of the server Core's ports and one composition root.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/database/migrate-command.ts",
    "switches": "tsx --env-file-if-exists=.env src/edition/switches-command.ts",
    "import-content": "tsx --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/content/import-command.ts",
    "admin": "tsx --env-file-if-exists=.env src/admin/admin-command.ts",
    "cron": "tsx --env-file-if-exists=.env src/alerts/cron-command.ts",
    "reports": "tsx --env-file-if-exists=.env src/reports/reports-command.ts",
    "quote-check": "tsx --env-file-if-exists=.env src/content/quote-check-command.ts",
    "recordings": "tsx --env-file-if-exists=.env src/recordings/recordings-command.ts",
    "collection-links": "tsx --env-file-if-exists=.env src/collection-links/collection-links-command.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@orpc/openapi": "^1.16.1",
    "@orpc/server": "^1.16.1",
    "@sentry/node": "^11.11.0",
    "@slovo/content-rules": "workspace:*",
    "@slovo/contracts": "workspace:*",
    "@slovo/language-pack": "workspace:*",
    "@slovo/server-core": "workspace:*",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@slovo/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
