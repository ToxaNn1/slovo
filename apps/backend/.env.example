# Copy to .env (kept out of git) for `pnpm dev`, `pnpm start` and `pnpm db:migrate`.
# The values below fit the local services of the repo's compose.yaml.

# The Postgres database of the backend.
DATABASE_URL=postgres://slovo:slovo@localhost:55432/slovo
# Where the sign-in emails go: Mailpit locally (read them at http://localhost:8025).
SMTP_URL=smtp://localhost:1025
# Signs the Sessions; at least 32 characters. Make your own: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters
# The port the backend listens on (default 8787).
PORT=8787
# The folder of the Edition folders (default: the repo's editions/).
# EDITIONS_DIR=
