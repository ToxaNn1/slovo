# Copy to .env (kept out of git) for `pnpm dev`, `pnpm start` and `pnpm db:migrate`.
# The values below fit the local services of the repo's compose.yaml.

# The Postgres database of the backend.
DATABASE_URL=postgres://slovo:slovo@localhost:55432/slovo
# `production` on a host. The server then refuses to start without SMTP_HOST,
# SMTP_PORT, SMTP_USER, SMTP_PASSWORD and MAIL_FROM (default development).
# NODE_ENV=
# Where the sign-in emails go. Unset, Mailpit locally (default localhost and
# 1025; read the emails at http://localhost:8025).
# SMTP_HOST=
# SMTP_PORT=
# The login at the SMTP server, both or neither (default none, as Mailpit).
# SMTP_USER=
# SMTP_PASSWORD=
# true speaks TLS from the first byte (port 465, usually); false (the default)
# upgrades with STARTTLS, which the server must offer when there is a login
# (the credentials never go in the clear) and may offer when there is none.
# SMTP_TLS=
# The address the sign-in emails come from (default no-reply@slovo.app).
# MAIL_FROM=
# Signs the Sessions; at least 32 characters. Make your own: openssl rand -base64 32
# (the server refuses this example value).
AUTH_SECRET=replace-with-at-least-32-random-characters
# The OAuth client ids of SLOVO at Google, comma-separated, for Sign in with
# Google: the iOS client id of each app (Google Cloud console, Credentials).
# Empty turns Google sign-in off; the repository holds no real id.
GOOGLE_CLIENT_IDS=

# The DSN of SLOVO's backend project at Sentry, where the backend reports its
# unexpected failures (500) with no personal data. Empty reports nothing; the
# repository holds no real DSN.
SENTRY_DSN=
# PostHog's query API for the admin's Аналітика: a personal API key with the
# read-only `query` scope and the project number. Unset, it answers «PostHog недоступний».
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Unset, https://eu.posthog.com.
POSTHOG_HOST=
# Розробка in the admin. A read-only fine-grained GitHub token (Pull requests,
# Actions, Contents, Issues and Metadata: read) on GITHUB_REPOSITORY (default
# ToxaNn1/slovo), and an EAS read token for EAS_PROJECT_ID (default the app's
# project). Empty shows that block as unavailable; the repository holds no token.
GITHUB_TOKEN=
GITHUB_REPOSITORY=ToxaNn1/slovo
EXPO_TOKEN=
EAS_PROJECT_ID=e2401ef2-2a47-407e-b0ff-03706421b71c
# How many proxies in front of the backend append to X-Forwarded-For, whose
# addresses it trusts for the limits per IP: 0 (the default) when nothing is
# in front, 1 behind Railway's proxy.
TRUSTED_PROXY_HOPS=0
# The port the backend listens on (default 8787).
PORT=8787
# The folder of the Edition folders (default: the repo's editions/).
# EDITIONS_DIR=
