{
  "name": "@slovo/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "The mobile shell: one Expo app that builds whichever Edition SLOVO_EDITION selects.",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && jest",
    "eas-build-post-install": "pnpm --dir ../.. build:pack \"$SLOVO_EDITION\"",
    "test:smoke": "maestro test maestro/smoke.yaml"
  },
