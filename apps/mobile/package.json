    "babel-jest": "29.7.0",
    "babel-preset-expo": "57.0.14",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expo-atlas": "~0.4.3",
    "jest": "29.7.0",
