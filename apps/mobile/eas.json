{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.23.3",
      "pnpm": "12.9.1",
      "ios": {
        "simulator": true
      }
    },
    "development-simulator-uk": {
      "extends": "development-simulator",
      "env": {
        "SLOVO_EDITION": "uk"
      }
    },
    "testflight-uk": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "channel": "uk",
      "node": "22.23.3",
      "pnpm": "12.9.1",
      "env": {
        "SLOVO_EDITION": "uk"
      }
    }
  },
  "submit": {
    "testflight-uk": {
      "ios": {}
    }
  }
}
