{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.23.4",
      "pnpm": "12.9.1",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_SLOVO_API_URL": "https://api.slovoapp.org"
      }
    },
    "beta": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "channel": "beta",
      "node": "22.23.4",
      "pnpm": "12.9.1"
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "node": "22.23.4",
      "pnpm": "12.9.1"
    }
  },
  "submit": {
    "beta": {
      "ios": {
        "ascAppId": "6839821318"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6839821318"
      }
    }
  }
}
