---
import { renderStress, type Word } from '@slovo/contracts';

import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Base from '../../layouts/Base.astro';
import { jsonLd } from '../../json-ld';
import { landingEdition } from '../../landing-edition';
import { sitePath } from '../../site-path';
import { siteWords, wordPagePath } from '../../site-words';
import {
  grammarLine,
  lemmaParts,
  longestRun,
  metaDescription,
  rarityBars,
  similarWords,
  synonymLinks,
} from '../../word-page';

/** A page for every live Word, at /slovo/<slug>. */
export async function getStaticPaths() {
  const { words, slugs } = await siteWords();
  return words.map((word) => {
    const slug = slugs.get(word.id);
    return { params: { slug }, props: { word, slug } };
  });
}

interface Props {
  word: Word;
  slug: string;
}

const { word, slug } = Astro.props;
const { words, slugs, pathOf } = await siteWords();
const { wordCard } = await landingEdition();
const grammar = grammarLine(word, wordCard);
const similar = similarWords(word, words);
const synonyms = synonymLinks(word.synonyms, words, slugs);
const source = word.sources[0];
const description = metaDescription(word);
const url = new URL(`/slovo/${slug}`, Astro.site).href;
const home = new URL('/', Astro.site).href;
// The Word as a term of SLOVO's dictionary, and where its page stands.
const structuredData = jsonLd({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'DefinedTerm',
      name: word.lemma,
      description: word.primaryDefinition,
      url,
      inLanguage: 'uk',
      inDefinedTermSet: { '@type': 'DefinedTermSet', name: 'SLOVO', url: home },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'SLOVO', item: home },
        { '@type': 'ListItem', position: 2, name: word.lemma, item: url },
      ],
    },
  ],
});
const heading =
  'font-word font-black tracking-[-0.03em] origin-left [transform:rotate(-3deg)_skewX(-6deg)]';
---

<Base title={`${word.lemma} — що означає слово | SLOVO`} description={description} lang="uk">
  <Fragment slot="head">
    <meta property="og:title" content={`${word.lemma} — що означає слово`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <script type="application/ld+json" set:html={structuredData} />
  </Fragment>
  <Header />
  <section class="relative overflow-hidden bg-red text-coal">
    <div class="absolute inset-y-0 right-0 w-[34%] bg-coal [clip-path:polygon(55%_0,100%_0,100%_100%,0_100%)]"></div>
    <div class="relative mx-auto flex max-w-[1312px] flex-col gap-[clamp(32px,5vw,72px)] px-[clamp(20px,4vw,56px)] pt-[clamp(24px,3vw,40px)] pb-[clamp(56px,7vw,104px)]">
      <nav aria-label="Хлібні крихти" class="flex flex-wrap gap-2 text-[15px] font-semibold">
        <a href={sitePath()} class="text-coal decoration-coal hover:text-coal">
          SLOVO
        </a>
        <span>›</span>
        <a href={sitePath('#word')} class="text-coal decoration-coal hover:text-coal">
          Слова
        </a>
        <span>›</span>
        <span aria-current="page">{word.lemma}</span>
      </nav>
      <div class="flex flex-col gap-[clamp(16px,2vw,24px)]">
        {/* Sized by the longest run so a long Lemma fits the red beside the coal wedge on one line; on a phone a run too long still breaks, with a hyphen. */}
        <h1
          style={`--run:${String(longestRun(word.lemma))}`}
          class="m-0 max-w-[min(62vw,25vw_+_560px)] origin-bottom-left py-2 font-word text-[length:clamp(32px,min(max(52px,9vw),calc(min(62vw,25vw_+_560px)/(var(--run)*0.95))),150px)] leading-[0.95] font-black tracking-[-0.05em] hyphens-auto [overflow-wrap:break-word] [transform:rotate(-3deg)_skewX(-6deg)]"
        >
          {lemmaParts(word).map((part) =>
            part.stressed ? <span class="text-paper">{part.text}</span> : part.text,
          )}
        </h1>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-[17px] font-bold">
          <span>{grammar}</span>
          <span class="flex items-center gap-1">
            <span aria-hidden="true" class="flex gap-1">
              {rarityBars(word.rarity).map((on) => (
                <span
                  class:list={['h-5 w-[9px] -skew-x-[14deg]', on ? 'bg-coal' : 'bg-red-edge']}
                />
              ))}
            </span>
            <span class="ml-2">рідкість {word.rarity} з 5</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <main class="mx-auto max-w-[1312px] px-[clamp(20px,4vw,56px)] pt-[clamp(56px,7vw,104px)]">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,460px),1fr))] items-start gap-x-[clamp(40px,6vw,96px)] gap-y-12">
      <div class="flex min-w-0 flex-col gap-[clamp(24px,3vw,36px)]">
        <h2 class="m-0 text-[clamp(18px,1.4vw,20px)] font-bold">Що означає «{word.lemma}»</h2>
        <p class="m-0 max-w-[30ch] text-[clamp(22px,2.4vw,32px)] leading-[1.35] font-medium text-pretty">
          {word.primaryDefinition}
        </p>
        {word.extraDefinitions.length > 0 && (
          <ol start="2" class="m-0 flex max-w-[52ch] list-decimal flex-col gap-3 pl-6 text-[17px]">
            {word.extraDefinitions.map((definition) => (
              <li>{definition}</li>
            ))}
          </ol>
        )}
        {word.examples.map((example, i) => (
          <figure class="m-0 flex flex-col gap-2 rounded-[18px] bg-sf2 p-[clamp(20px,2.4vw,28px)]">
            {i === 0 && <figcaption class="text-[15px] font-bold">Приклад</figcaption>}
            <blockquote class="m-0 text-[19px] leading-normal italic">«{example.text}»</blockquote>
            {example.author !== undefined && <span class="text-[15px]">— {example.author}</span>}
          </figure>
        ))}
        {synonyms.length > 0 && (
          <p class="m-0 text-[17px]">
            <span class="font-bold">{synonyms.length === 1 ? 'Синонім' : 'Синоніми'}: </span>
            {synonyms.map((synonym, i) => (
              <>
                {i > 0 && ', '}
                {synonym.slug === undefined ? (
                  synonym.text
                ) : (
                  <a href={wordPagePath(synonym.slug)}>{synonym.text}</a>
                )}
              </>
            ))}
          </p>
        )}
        {source !== undefined && (
          <p class="m-0 text-sm">
            Джерело:{' '}
            {source.url === undefined ? (
              <span class="font-bold">{source.shortName ?? source.title}</span>
            ) : (
              <a href={source.url} class="font-bold" rel="noopener">
                {source.shortName ?? source.title}
              </a>
            )}
          </p>
        )}
      </div>
      <aside class="flex flex-col items-start gap-5 rounded-[18px] bg-coal p-[clamp(24px,3vw,40px)] text-cream">
        <h2 class:list={[heading, 'm-0 text-[clamp(24px,2.4vw,32px)] leading-[1.08]']}>
          Тримай це слово.
        </h2>
        <p class="m-0 max-w-[30ch] text-[17px]">
          Збережи «{word.lemma}» у колекцію — застосунок нагадає про нього через 1, 3, 7, 30 і 90
          днів.
        </p>
        <div
          aria-disabled="true"
          class="flex cursor-default flex-col rounded-2xl bg-red px-[26px] py-3.5 leading-[1.1] text-coal"
        >
          <span class="text-[13px] font-semibold">Скоро в</span>
          <span class="font-word text-[22px] font-extrabold whitespace-nowrap">App Store</span>
        </div>
      </aside>
    </div>

    {similar.length > 0 && (
      <section class="mt-[clamp(88px,10vw,152px)]">
        <h2 class:list={[heading, 'm-0 mb-[clamp(28px,3vw,44px)] text-[clamp(28px,3.4vw,48px)]']}>
          Схожі слова
        </h2>
        <ul class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(min(100%,190px),1fr))] gap-x-3.5 gap-y-[18px] p-0">
          {similar.map((other) => (
            <li>
              <a
                href={pathOf(other)}
                class="flex h-full flex-col gap-1.5 rounded-[14px] bg-tile p-[18px] text-ink no-underline shadow-[0_5px_0_var(--edge)] transition-[translate,box-shadow] duration-[120ms] ease-out hover:-translate-y-0.5 hover:text-ink hover:shadow-[0_7px_0_var(--edge)] active:translate-y-1 active:shadow-[0_1px_0_var(--edge)]"
              >
                <span class="font-word text-xl font-black tracking-[-0.02em]">
                  {renderStress(other)}
                </span>
                <span class="line-clamp-2 text-sm">{other.primaryDefinition}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-[clamp(88px,10vw,152px)] mb-[clamp(72px,9vw,136px)] grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] items-end gap-x-[clamp(40px,6vw,96px)] gap-y-6">
      <h2 class="m-0 max-w-[16ch] font-word text-[clamp(26px,3vw,42px)] leading-[1.05] font-black tracking-[-0.03em]">
        Рідкісні українські слова — щодня в кишені.
      </h2>
      <div class="flex flex-col items-start gap-5">
        <p class="m-0 max-w-[40ch] text-lg">
          SLOVO — застосунок для iPhone: слово дня, ігри, колекції з повтореннями і щоденний
          кросворд. Українська, якої не вчили в школі.
        </p>
        <a
          href={sitePath()}
          class="inline-flex h-[52px] items-center rounded-2xl bg-red px-6 font-word text-sm font-extrabold text-coal no-underline shadow-[0_5px_0_var(--red-edge)] transition-[translate,box-shadow] duration-[120ms] ease-out hover:-translate-y-0.5 hover:text-coal hover:shadow-[0_7px_0_var(--red-edge)] active:translate-y-1 active:shadow-[0_1px_0_var(--red-edge)]"
        >
          Про застосунок
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
