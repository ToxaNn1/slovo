---
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Inside from '../components/Inside.astro';
import Mission from '../components/Mission.astro';
import Screens from '../components/Screens.astro';
import WordOfDay from '../components/WordOfDay.astro';
import Base from '../layouts/Base.astro';

const description = 'Спочатку було слово. Потім його забули. Повертаємо.';
---

<Base
  title="SLOVO — Тримай слово."
  description="Рідкісні українські слова щодня: стрічка, слово дня, кросворд та ігри. Спочатку було слово. Потім його забули. Повертаємо."
  lang="uk"
>
  <Fragment slot="head">
    <meta property="og:title" content="SLOVO — Тримай слово." />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </Fragment>
  <Header />
  <main id="top">
    <Hero />
    <WordOfDay />
    <Inside />
    <Screens />
    <Mission />
    <Faq />
    <Cta />
  </main>
  <Footer />
</Base>
