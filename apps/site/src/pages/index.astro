---
import Cta from '../components/Cta.astro';
import Episodes from '../components/Episodes.astro';
import Faq from '../components/Faq.astro';
import Features from '../components/Features.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Mission from '../components/Mission.astro';
import Promo from '../components/Promo.astro';
import Screens from '../components/Screens.astro';
import WordOfDay from '../components/WordOfDay.astro';
import Base from '../layouts/Base.astro';
import { jsonLd } from '../json-ld';

const description = 'Спочатку було слово. Потім його забули. Повертаємо.';
// Who the site belongs to, for search engines.
const structuredData = jsonLd({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'SLOVO',
      url: 'https://slovoapp.org/',
      logo: 'https://slovoapp.org/og.png',
    },
    { '@type': 'WebSite', name: 'SLOVO', url: 'https://slovoapp.org/', inLanguage: 'uk' },
  ],
});
---

<Base
  title="SLOVO — Тримай слово."
  description="Рідкісні українські слова щодня: стрічка, слово дня, кросворд та ігри. Спочатку було слово. Потім його забули. Повертаємо."
  lang="uk"
>
  <Fragment slot="head">
    <meta property="og:title" content="SLOVO — Тримай слово." />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script type="application/ld+json" set:html={structuredData} />
  </Fragment>
  <Header />
  <main id="top">
    <Hero />
    <HowItWorks />
    <WordOfDay />
    <Features />
    <Screens />
    <Promo />
    <Episodes />
    <Mission />
    <Faq />
    <Cta />
  </main>
  <Footer />
</Base>

<script>
  // Each section's parts below the first screen rise into place once, as the
  // reader scrolls to them (global.css `[data-rise]`). Nothing moves for a
  // reader who asks for less motion.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting || !(entry.target instanceof HTMLElement)) continue;
          observer.unobserve(entry.target);
          entry.target.dataset['rise'] = 'shown';
        }
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    for (const section of document.querySelectorAll('main > section:not(:first-child)')) {
      [...section.children].forEach((part, i) => {
        if (!(part instanceof HTMLElement) || part.getBoundingClientRect().top < innerHeight)
          return;
        part.dataset['rise'] = 'hidden';
        part.style.setProperty('--rise-i', String(Math.min(i, 3)));
        part.addEventListener('transitionend', function settle(event) {
          if (
            event.target !== part ||
            event.propertyName !== 'translate' ||
            part.dataset['rise'] !== 'shown'
          )
            return;
          part.removeEventListener('transitionend', settle);
          delete part.dataset['rise'];
          part.style.removeProperty('--rise-i');
        });
        observer.observe(part);
      });
    }
  }
</script>
