---
import type { MascotState } from '@slovo/contracts';

import { landingEdition } from '../landing-edition';
import { drawMascot, mascotMotionCss, type MascotPath } from '../mascot';

interface Props {
  state: MascotState;
  /** The variant for a red ground: a cream body, black ink. */
  onRed?: boolean;
  class?: string;
}

const { state, onRed = false, class: className } = Astro.props;
const paints = onRed
  ? { body: 'var(--cream)', ink: 'var(--coal)', accent: 'var(--coal)' }
  : {
      body: state === 'hatOff' ? 'var(--mute)' : 'var(--red)',
      ink: 'var(--ink)',
      accent: 'var(--red)',
    };
const { mascot } = await landingEdition();
const drawing = drawMascot(mascot, state, paints);
const motion = mascotMotionCss(state);
const attrs = (path: MascotPath): astroHTML.JSX.SVGAttributes => ({
  d: path.d,
  fill: path.fill,
  stroke: path.stroke,
  'stroke-width': path.strokeWidth,
  'stroke-linecap': path.stroke === undefined ? undefined : 'round',
  'stroke-linejoin': path.stroke === undefined ? undefined : 'round',
  opacity: path.opacity === 1 ? undefined : path.opacity,
});
---

{motion !== undefined && <style set:html={motion.keyframes} />}
<div class:list={['flex-none', className]} aria-hidden="true">
  <div
    class="size-full origin-[30%_60%]"
    style={motion === undefined ? undefined : `animation:${motion.animation}`}
  >
    <svg viewBox={drawing.viewBox} width="100%" class="block overflow-visible">
      <g class="animate-ray">
        {drawing.behind.map((path) => (
          <path {...attrs(path)} />
        ))}
      </g>
      <g transform={drawing.turn}>
        {drawing.figure.map((path) => (
          <path {...attrs(path)} />
        ))}
        <g transform={drawing.hatShift}>
          {drawing.hat.map((path) => (
            <path {...attrs(path)} />
          ))}
        </g>
      </g>
      {drawing.front.map((path) => (
        <path {...attrs(path)} />
      ))}
    </svg>
  </div>
</div>
