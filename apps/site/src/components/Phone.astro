---
/** A phone mock-up: the dark body, the screen (styled by `class`), the status bar and the caption below. */
interface Props {
  label: string;
  /** Sets the phone lower than its neighbours, as the design staggers them. */
  lowered?: boolean;
  class?: string;
}

const { label, lowered = false, class: screenClass } = Astro.props;
---

<figure class:list={['m-0 flex flex-none snap-center flex-col gap-4', lowered && 'pt-14']}>
  <div class="h-[540px] w-[262px] rounded-[44px] bg-coal-tile p-[9px]">
    <div class:list={['relative flex h-full flex-col overflow-hidden rounded-[36px]', screenClass]}>
      <div class="relative flex justify-between text-xs font-bold">
        <span>9:41</span>
        <span>●●●</span>
      </div>
      <slot />
    </div>
  </div>
  <figcaption class="text-base font-semibold">{label}</figcaption>
</figure>
