---
import Phone from './Phone.astro';

const label =
  'self-start -skew-x-[10deg] px-[7px] py-[5px] font-word leading-none font-extrabold tracking-[1px]';
const feed = [
  { topic: 'РІДКІСНЕ', word: 'мжи́чка', meaning: 'Дрібний густий дощ; мряка.' },
  {
    topic: 'НАУКА',
    word: 'сизигі́я',
    meaning: 'Розташування Сонця, Місяця й Землі на одній прямій.',
  },
  { topic: 'ПОБУТ', word: 'окра́єць', meaning: 'Відрізаний край хлібини.' },
];
/* The crossword's 7×7 grid, row by row: a space is an empty cell; the third row is the red answer. */
const crossword = ['   М   ', '   А   ', 'КРАР   ', '   Е   ', '   В   ', '   О   '];
const answerRow = 2;
const tile = 'grid place-items-center font-word leading-none font-extrabold';
const plainTile = 'bg-tile shadow-[0_3px_0_var(--edge)]';
const redTile = 'bg-red text-coal shadow-[0_3px_0_var(--red-edge)]';
---

<section>
  <div class="mx-auto flex max-w-[1280px] flex-col gap-[clamp(32px,4vw,48px)] px-[clamp(16px,4vw,40px)] py-[clamp(56px,8vw,112px)]">
    <div class="flex flex-wrap items-end justify-between gap-5">
      <h2 class="m-0 max-w-[18ch] origin-left -rotate-3 font-word text-[clamp(36px,4.8vw,68px)] leading-none font-black tracking-[-0.035em] text-balance">
        Слова, яких ти ще не знаєш, але вже любиш.
      </h2>
      <span class="rounded-md border-[1.5px] border-dashed border-red px-2.5 py-[7px] font-ui text-xs leading-[1.3] font-bold text-red">
        ЗАГЛУШКА: макети, не справжні скріншоти
      </span>
    </div>
    <div class="flex snap-x snap-mandatory gap-7 overflow-x-auto px-1 pt-2.5 pb-7">
      <Phone label="СТРІЧКА" class="gap-2.5 bg-bg px-2.5 pt-[46px] pb-2.5">
        <div class="flex items-center gap-1.5 px-1.5 pb-1">
          <span class="h-[15px] w-2.5 bg-red [clip-path:polygon(0_0,100%_22%,100%_78%,0_100%)]"></span>
          <span class="font-word text-[15px] leading-none font-black">SLOVO</span>
        </div>
        {feed.map((entry) => (
          <div class="flex flex-col gap-2 rounded-[18px] border border-line bg-sf p-3.5">
            <span class:list={[label, 'bg-ink text-[8px] text-bg']}>{entry.topic}</span>
            <span class="font-word text-[22px] leading-[1.05] font-black">{entry.word}</span>
            <span class="font-ui text-xs leading-[1.4] text-mute">{entry.meaning}</span>
          </div>
        ))}
      </Phone>

      <Phone label="КАРТКА СЛОВА" class="gap-3 bg-red px-[18px] pt-14 pb-[18px] text-coal">
        <span class:list={[label, 'bg-coal text-[9px] text-cream']}>СЛОВО ДНЯ</span>
        <span class="mt-[30px] -rotate-4 font-word text-[38px] leading-none font-black tracking-[-0.03em]">
          гризо́та
        </span>
        <span class="font-ui text-xs leading-none font-semibold">іменник, ж. р.</span>
        <span class="font-ui text-[15px] leading-[1.45] font-medium">
          Те, що гризе, мучить; журба, турбота.
        </span>
        <div class="mt-auto flex gap-2">
          <span class="grid h-[46px] flex-1 place-items-center rounded-xl bg-cream font-word text-[10px] leading-none font-extrabold shadow-[0_4px_0_var(--coal)]">
            В ОБРАНЕ
          </span>
          <span class="grid h-[46px] flex-1 place-items-center rounded-xl bg-coal font-word text-[10px] leading-none font-extrabold text-cream shadow-[0_4px_0_var(--color-shadow-red)]">
            ЗАСВОЇВ
          </span>
        </div>
      </Phone>

      <Phone label="КРОСВОРД" class="gap-3.5 bg-bg px-3.5 pt-[52px] pb-3.5">
        <span class="origin-left -rotate-3 font-word text-[22px] leading-none font-black">
          Кросворд дня
        </span>
        <div class="grid grid-cols-7 gap-1">
          {crossword.flatMap((row, r) =>
            [...row].map((letter) =>
              r === answerRow || letter !== ' ' ? (
                <span
                  class:list={[
                    'aspect-square rounded-md text-[13px]',
                    tile,
                    r === answerRow ? redTile : plainTile,
                  ]}
                >
                  {letter.trim()}
                </span>
              ) : (
                <span />
              ),
            ),
          )}
        </div>
        <div class="mt-auto flex flex-col gap-1.5 rounded-2xl bg-sf2 p-3">
          <span class="font-word text-[9px] leading-none font-extrabold tracking-[1px] text-red">
            3 · ПО ГОРИЗОНТАЛІ
          </span>
          <span class="font-ui text-[13px] leading-[1.4] font-medium">
            Тріщинки на старій олійній картині (7)
          </span>
        </div>
      </Phone>

      <Phone label="ГРА «НАГОЛОС»" class="gap-3.5 bg-bg px-4 pt-[52px] pb-[18px]">
        <div class="flex items-center justify-between">
          <span class="origin-left -rotate-3 font-word text-[22px] leading-none font-black">
            Наголос
          </span>
          <span class="font-word text-[11px] leading-none font-extrabold text-mute">4 / 10</span>
        </div>
        <div class="h-2 overflow-hidden rounded-sm bg-sf2">
          <div class="h-full w-[40%] bg-red"></div>
        </div>
        <div class="grid flex-1 place-items-center">
          <div class="flex gap-1">
            {[...'МАРЕВО'].map((letter) => (
              <span
                class:list={[
                  'h-[42px] w-[34px] rounded-lg bg-tile text-lg shadow-[0_4px_0_var(--edge)]',
                  tile,
                ]}
              >
                {letter}
              </span>
            ))}
          </div>
        </div>
        <span class="flex h-[54px] items-center justify-between rounded-[14px] bg-red px-4 font-word text-lg leading-none font-black text-coal shadow-[0_4px_0_var(--red-edge)]">
          ма́рево<span class="font-ui text-base leading-none font-extrabold">✓</span>
        </span>
        <span class="flex h-[54px] items-center rounded-[14px] border border-line bg-sf px-4 font-word text-lg leading-none font-black text-mute shadow-[0_4px_0_var(--edge)]">
          маре́во
        </span>
      </Phone>
    </div>
  </div>
</section>
