---
import CrossGrid from './CrossGrid.astro';
import Phone from './Phone.astro';

const light = 'gap-3 bg-cream px-4 py-[18px] text-coal';
const screenTitle = 'mt-2 font-word text-2xl font-black tracking-[-0.03em]';
const card = 'flex flex-col gap-1.5 rounded-[18px] p-4';
const cardWord = 'font-word text-[22px] font-black tracking-[-0.02em]';
const game = 'flex h-[92px] items-end rounded-[18px] p-3 font-word font-extrabold';
---

<section class="mt-[clamp(88px,11vw,168px)] bg-coal text-cream">
  <div class="mx-auto max-w-[1312px] px-[clamp(20px,4vw,56px)] pt-[clamp(72px,9vw,136px)]">
    <h2 class="m-0 max-w-[20ch] origin-left [transform:rotate(-3deg)_skewX(-6deg)] font-word text-[calc(3vw_+_20px)] leading-[1.04] font-black tracking-[-0.035em]">
      Слова, яких ти ще не знаєш, але вже любиш.
    </h2>
  </div>
  <div class="mx-auto flex max-w-[1312px] snap-x snap-mandatory items-start justify-[safe_center] gap-[clamp(16px,2vw,28px)] overflow-x-auto px-[clamp(20px,4vw,56px)] pt-[clamp(48px,6vw,88px)] pb-[clamp(72px,9vw,136px)] [scrollbar-width:none]">
    <Phone label="Стрічка" class={light}>
      <div class={screenTitle}>Стрічка</div>
      <div class:list={[card, 'bg-paper']}>
        <span class={cardWord}>
          гриз<span class="text-red">о́</span>та
        </span>
        <span class="text-xs font-semibold text-paper-mute">іменник, ж. р.</span>
        <span class="text-[13px] leading-[1.4]">Те, що гризе, мучить; клопіт, турбота.</span>
      </div>
      <div class:list={[card, 'bg-red']}>
        <span class={cardWord}>бундю́чний</span>
        <span class="text-[13px] leading-[1.4]">Пихатий, зарозумілий.</span>
      </div>
      <div class:list={[card, 'bg-paper']}>
        <span class={cardWord}>
          кракел<span class="text-red">ю́</span>р
        </span>
        <span class="text-[13px] leading-[1.4]">Тріщинки на витворах мистецтва…</span>
      </div>
    </Phone>

    <Phone label="Картка слова" lowered class="gap-4 bg-red px-[18px] pt-[18px] pb-7 text-coal">
      <div class="absolute inset-x-0 bottom-0 h-[46%] bg-coal [clip-path:polygon(0_30%,100%_0,100%_100%,0_100%)]"></div>
      <span class="relative mt-4 self-start -skew-x-10 bg-coal px-2 py-1 text-[10px] font-bold tracking-[0.1em] whitespace-nowrap text-cream">
        СЛОВО ДНЯ
      </span>
      <div class="relative origin-left [transform:rotate(-4deg)_skewX(-6deg)] font-word text-[34px] leading-none font-black tracking-[-0.04em]">
        сизиг<span class="text-paper">і́</span>я
      </div>
      <span class="relative text-xs font-bold">іменник, ж. р.</span>
      <span class="relative text-sm leading-[1.45] font-medium">
        Розташування Сонця, Місяця й Землі на одній прямій.
      </span>
      <div class="relative mt-auto flex gap-2">
        <span class="grid h-11 flex-1 place-items-center rounded-[14px] bg-paper font-word text-xs font-extrabold shadow-[0_4px_0_var(--paper-edge)]">
          Зберегти
        </span>
        <span class="grid size-11 place-items-center rounded-[14px] bg-coal-tile font-bold text-cream">
          ↗
        </span>
      </div>
    </Phone>

    <Phone label="Ігри" class={light}>
      <div class={screenTitle}>Ігри</div>
      <div class="grid grid-cols-2 gap-2.5">
        <div class="col-span-2 flex h-[110px] flex-col justify-between rounded-[18px] bg-red p-3.5 shadow-[0_4px_0_var(--red-edge)]">
          <span class="text-[11px] font-bold">Щоденна</span>
          <span class="font-word text-xl font-black">Наголос</span>
        </div>
        <div class:list={[game, 'bg-paper text-[13px] shadow-[0_4px_0_var(--paper-edge)]']}>
          Пари
        </div>
        <div class:list={[game, 'min-w-0 bg-paper text-[11px] shadow-[0_4px_0_var(--paper-edge)]']}>
          Анаграми
        </div>
        <div
          class:list={[
            game,
            'bg-paper text-[11px] leading-[1.2] shadow-[0_4px_0_var(--paper-edge)]',
          ]}
        >
          Обери правильне
        </div>
        <div
          class:list={[game, 'bg-coal text-[13px] text-cream shadow-[0_4px_0_var(--coal-edge)]']}
        >
          На час
        </div>
      </div>
    </Phone>

    <Phone label="Кросворд" lowered class="gap-3.5 bg-cream px-4 py-[18px] text-coal">
      <div class={screenTitle}>Кросворд</div>
      <CrossGrid small />
      <div class="rounded-[14px] bg-paper-sunk px-3.5 py-3 text-xs leading-[1.45]">
        <b>3 по горизонталі.</b> Пихатий, зарозумілий (9)
      </div>
    </Phone>
  </div>
</section>
