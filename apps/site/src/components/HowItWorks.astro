---
/** The three steps, each a verb with its stressed vowel in red. */
const steps = [
  {
    before: 'Відкр',
    vowel: 'и́',
    after: 'й.',
    text: 'Щодня — нове рідкісне українське слово з тлумаченням, наголосом і прикладом.',
  },
  {
    before: 'Гр',
    vowel: 'а',
    after: 'й.',
    text: 'Наголос, пари, анаграми — слово запам’ятовується, коли з ним граєш.',
  },
  {
    before: 'Трим',
    vowel: 'а́',
    after: 'й.',
    text: 'Повторення через 1, 3, 7, 30 і 90 днів повертають слово, доки воно не стане твоїм.',
  },
];
---

<section
  id="how"
  class="mx-auto max-w-[1312px] px-[clamp(20px,4vw,56px)] pt-[clamp(88px,11vw,168px)]"
>
  <h2 class="m-0 mb-[clamp(36px,5vw,64px)] text-[clamp(20px,1.6vw,24px)] font-bold">
    Як це працює
  </h2>
  <ol class="m-0 flex list-none flex-col gap-[clamp(28px,4vw,48px)] p-0">
    {steps.map((step) => (
      <li class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] items-baseline gap-x-12 gap-y-3">
        <span class="origin-left -skew-x-6 font-word text-[clamp(46px,6.2vw,90px)] leading-none font-black tracking-[-0.04em]">
          {step.before}
          <span class="text-red">{step.vowel}</span>
          {step.after}
        </span>
        <p class="m-0 max-w-[30ch] text-[clamp(19px,1.8vw,24px)] leading-[1.4]">{step.text}</p>
      </li>
    ))}
  </ol>
</section>
