---
import { ThemeToggle } from './ThemeToggle';

const links = [
  { href: '#how', label: 'Як це працює' },
  { href: '#word', label: 'Слово дня' },
  { href: '#games', label: 'Ігри' },
  { href: '#faq', label: 'Питання' },
];
---

<header class="sticky top-0 z-10 bg-red text-coal">
  <div class="mx-auto flex max-w-[1312px] items-center gap-[clamp(10px,2.4vw,40px)] px-[clamp(20px,4vw,56px)] py-3.5">
    <a
      href="#top"
      class="-skew-x-6 font-word text-[22px] font-black tracking-[-0.03em] text-coal no-underline hover:text-coal"
    >
      SLOVO
    </a>
    <nav class="hidden gap-7 text-[15px] font-semibold whitespace-nowrap nav:flex">
      {links.map((link) => (
        <a href={link.href} class="text-coal no-underline hover:text-coal">
          {link.label}
        </a>
      ))}
    </nav>
    <div class="flex-1"></div>
    <ThemeToggle client:load />
    <span
      aria-disabled="true"
      class="flex h-[38px] flex-none items-center rounded-xl bg-coal px-[clamp(12px,1.2vw,16px)] font-word text-[clamp(11px,0.9vw,12px)] font-extrabold whitespace-nowrap text-cream"
    >
      Скоро в App Store
    </span>
  </div>
</header>
