---
import { landingEdition } from '../landing-edition';
import { siteWords } from '../site-words';
import { wordOfDay } from '../word-of-day';
import { grammarLine, lemmaParts, rarityBars } from '../word-page';

/** The site's one Word of the Day, picked by the date in Kyiv the site is built on (ADR 0148). */
const { words, pathOf } = await siteWords();
const word = wordOfDay(words, new Date());
if (word === undefined) throw new Error('No live Word is rare enough to be the Word of the Day.');
const { wordCard } = await landingEdition();
const example = word.examples[0];
---

<section id="word" class="mt-[clamp(88px,11vw,168px)] bg-sf2">
  <div class="mx-auto max-w-[1312px] px-[clamp(20px,4vw,56px)] py-[clamp(64px,8vw,120px)]">
    <div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-4">
      <h2 class="m-0 max-w-[16ch] origin-left [transform:rotate(-3deg)_skewX(-6deg)] font-word text-[clamp(26px,3.4vw,48px)] leading-[1.05] font-black tracking-[-0.03em]">
        Знайди слово, якого бракувало.
      </h2>
      <p class="m-0 max-w-[34ch] text-[17px]">
        Слово дня українською — щоранку нове, з академічних словників.
      </p>
    </div>
    <article class="mt-[clamp(48px,6vw,88px)] flex flex-col gap-[clamp(20px,2.4vw,32px)]">
      <div class="flex items-center gap-4">
        <span class="-skew-x-10 bg-red px-2.5 py-[5px] text-[11px] font-bold tracking-[0.1em] whitespace-nowrap text-coal">
          СЛОВО ДНЯ
        </span>
        <span aria-label={`Рідкість ${String(word.rarity)} з 5`} role="img" class="flex gap-1">
          {rarityBars(word.rarity).map((on) => (
            <span class:list={['h-5 w-[9px] -skew-x-[14deg]', on ? 'bg-red' : 'bg-edge']} />
          ))}
        </span>
      </div>
      <div class="font-word text-[calc(8vw_+_20px)] leading-none font-black tracking-[-0.045em]">
        {lemmaParts(word).map((part) =>
          part.stressed ? <span class="text-red">{part.text}</span> : part.text,
        )}
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] items-start gap-x-[clamp(32px,5vw,80px)] gap-y-6">
        <div class="text-[17px] font-semibold">
          {grammarLine(word, wordCard)}
          <br />
          рідкість {word.rarity} з 5
        </div>
        <div class="flex min-w-0 flex-col gap-6">
          <p class="m-0 text-[clamp(21px,2.2vw,30px)] leading-[1.35] font-medium text-pretty">
            {word.primaryDefinition}
          </p>
          {example !== undefined && <p class="m-0 text-lg italic">«{example.text}»</p>}
          <a href={pathOf(word)} class="self-start text-lg font-bold">
            Більше про це слово →
          </a>
        </div>
      </div>
    </article>
  </div>
</section>
