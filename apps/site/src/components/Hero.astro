---
import { GoalBoard } from './GoalBoard';
import Mascot from './Mascot.astro';

/** The letters of «ГРИЗОТА» flying out of the Mascot's horn: tilt, start offset, place, ground, delays. */
const letters = [
  { ch: 'Г', r: -10, fx: -110, fy: 160, x: 52, y: 20, dark: false, d: 0.3, b: 1.4 },
  { ch: 'Р', r: 6, fx: -165, fy: 200, x: 63, y: 12, dark: true, d: 0.42, b: 1.55 },
  { ch: 'И', r: -4, fx: -220, fy: 170, x: 74, y: 18, dark: false, d: 0.54, b: 1.7 },
  { ch: 'З', r: 9, fx: -270, fy: 120, x: 84, y: 28, dark: false, d: 0.66, b: 1.85 },
  { ch: 'О', r: -12, fx: -190, fy: 90, x: 68, y: 34, dark: false, d: 0.78, b: 2 },
  { ch: 'Т', r: 5, fx: -245, fy: 40, x: 79, y: 44, dark: true, d: 0.9, b: 2.15 },
  { ch: 'А', r: -7, fx: -290, fy: -20, x: 88, y: 56, dark: false, d: 1.02, b: 2.3 },
];
---

<section class="relative overflow-hidden bg-red text-coal">
  <div class="absolute inset-0 bg-coal [clip-path:polygon(0_88%,100%_70%,100%_100%,0_100%)]"></div>
  <div class="relative mx-auto grid max-w-[1280px] grid-cols-[repeat(auto-fit,minmax(min(100%,460px),1fr))] items-center gap-[clamp(36px,5vw,64px)] px-[clamp(16px,4vw,40px)] pt-[clamp(40px,6vw,88px)] pb-[clamp(110px,14vw,200px)]">
    <div class="flex min-w-0 flex-col gap-7">
      <h1 class="m-0 origin-bottom-left [transform:rotate(-5deg)_skewX(-6deg)] pt-[0.15em] pb-[0.1em] font-word text-[clamp(54px,8vw,124px)] leading-[0.92] font-black tracking-[-0.04em]">
        Тримай
        <br />
        слово.
      </h1>
      <p class="m-0 max-w-[26ch] font-ui text-[clamp(19px,1.9vw,24px)] leading-[1.35] font-semibold text-pretty">
        Спочатку було слово. Потім його забули. Повертаємо.
      </p>
      <div id="download" class="flex flex-wrap items-center gap-5">
        <a
          href="#"
          class="inline-flex min-h-16 items-center rounded-[14px] bg-coal px-[30px] font-word text-[17px] leading-none font-extrabold text-cream no-underline shadow-[0_6px_0_var(--color-shadow-red)] transition-[translate,box-shadow] duration-[120ms] hover:translate-y-0.5 hover:text-cream hover:shadow-[0_4px_0_var(--color-shadow-red)] active:translate-y-1.5 active:shadow-none"
        >
          Завантажити в App Store
        </a>
        <div class="hidden size-[84px] place-items-center rounded-xl border-2 border-dashed border-coal bg-cream/25 text-center font-word text-[10px] leading-[1.3] font-extrabold desk:grid">
          QR
          <br />
          ЗАГЛУШКА
        </div>
      </div>
      <div class="flex flex-col gap-3.5 pt-1.5">
        <GoalBoard client:visible />
        <div class="flex flex-wrap items-center gap-3">
          <span class="font-ui text-base leading-[1.35] font-bold">
            рідкісних слів уже повернуто у вжиток
          </span>
          <span class="-skew-x-10 bg-coal px-2.5 py-[7px] font-word text-[11px] leading-none font-extrabold tracking-[1px] text-cream">
            МЕТА — МІЛЬЙОН
          </span>
        </div>
        <span class="self-start rounded-md border-[1.5px] border-dashed border-coal px-2 py-1.5 font-ui text-xs leading-none font-bold">
          ЗАГЛУШКА: демо-число
        </span>
      </div>
    </div>

    <div class="relative aspect-square max-h-[600px] w-full min-w-0 overflow-hidden rounded-3xl border-[2.5px] border-dashed border-coal bg-cream/[0.18]">
      <span class="absolute top-[18px] left-[18px] z-[3] -skew-x-10 bg-coal px-2.5 py-[7px] font-word text-[11px] leading-none font-extrabold tracking-[1px] text-cream">
        ЗАГЛУШКА · 2D-ВІДЕО
      </span>
      <div class="absolute top-[30%] left-[6%] w-[52%] -rotate-14">
        <Mascot
          state="shouts"
          onRed
          class="w-[170px] min-[600px]:w-[230px] min-[1000px]:w-[290px]"
        />
      </div>
      <div class="absolute inset-0">
        {letters.map((l) => (
          <span
            style={`--r:${l.r}deg;--fx:${l.fx}px;--fy:${l.fy}px;--x:${l.x}%;--y:${l.y}%;--d:${l.d}s;--b:${l.b}s`}
            class:list={[
              'absolute top-(--y) left-(--x) -ml-[22px] grid h-[clamp(44px,5.2vw,62px)] w-[clamp(38px,4.4vw,54px)] [transform:rotate(var(--r))] animate-[fly_0.7s_cubic-bezier(0.2,0.9,0.3,1.2)_var(--d)_both,float_2.6s_ease-in-out_var(--b)_infinite] place-items-center rounded-[10px] font-word text-[clamp(20px,2.4vw,30px)] leading-none font-black',
              l.dark
                ? 'bg-coal text-cream shadow-[0_5px_0_var(--color-shadow-red)]'
                : 'bg-cream text-coal shadow-[0_5px_0_var(--coal)]',
            ]}
          >
            {l.ch}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
