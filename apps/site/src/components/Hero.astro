---
import { formatCount, goal } from '../goal';
import AppStoreBadge from './AppStoreBadge.astro';
import LetterTiles, { type Tile } from './LetterTiles.astro';
import Mascot from './Mascot.astro';

const tiles: Tile[] = [
  { ch: 'Г', tilt: 'rotate(-6deg)' },
  { ch: 'Р', tilt: 'translateY(-8px) rotate(4deg)' },
  { ch: 'И', tilt: 'rotate(-2deg)' },
  { ch: 'З', tilt: 'translateY(-8px) rotate(5deg)', ground: 'red' },
  { ch: 'О́', tilt: 'rotate(-5deg)' },
  { ch: 'Т', tilt: 'translateY(-5px) rotate(3deg)' },
  { ch: 'А', tilt: 'rotate(-3deg)' },
];
---

<section class="relative overflow-hidden bg-red text-coal">
  <div class="absolute inset-x-0 bottom-0 h-[42%] bg-coal [clip-path:polygon(0_62%,100%_0,100%_100%,0_100%)]"></div>
  <div class="relative mx-auto grid max-w-[1312px] grid-cols-[repeat(auto-fit,minmax(min(100%,520px),1fr))] items-end gap-[clamp(40px,5vw,72px)] px-[clamp(20px,4vw,56px)] pt-[clamp(40px,6vw,88px)] pb-[clamp(48px,7vw,104px)]">
    <div class="flex flex-col items-start gap-[clamp(24px,3vw,36px)] pb-[clamp(0px,4vw,64px)]">
      <h1 class="m-0 origin-bottom-left [transform:rotate(-4deg)_skewX(-6deg)] font-word text-[clamp(60px,7.6vw,110px)] leading-[0.88] font-black tracking-[-0.045em]">
        Тримай
        <br />
        слово.
      </h1>
      <p class="m-0 max-w-[22ch] text-[clamp(21px,2vw,28px)] leading-[1.3] font-semibold text-pretty">
        Спочатку було слово. Потім його забули. Повертаємо.
      </p>
      <AppStoreBadge />
    </div>
    <div class="relative flex w-full max-w-[480px] flex-col gap-5 justify-self-end">
      <div class="relative grid aspect-[4/5] place-items-center overflow-hidden rounded-[18px] bg-coal-sunk [--ink:var(--cream)]">
        <Mascot state="shouts" class="w-[62%]" />
      </div>
      <LetterTiles
        tiles={tiles}
        class="grid-cols-[repeat(7,minmax(0,1fr))] pt-3.5"
        size="text-[clamp(17px,2.4vw,30px)]"
      />
    </div>
  </div>
  <div class="relative mx-auto flex max-w-[1312px] flex-wrap items-baseline gap-x-5 gap-y-2 px-[clamp(20px,4vw,56px)] pt-[clamp(24px,3vw,40px)] pb-[clamp(32px,4vw,56px)] text-cream">
    <span class="font-word text-[clamp(30px,3.4vw,48px)] font-black tracking-[-0.03em] whitespace-nowrap text-red tabular-nums">
      {formatCount(goal.confirmed)}
    </span>
    <span class="max-w-[34ch] text-[17px] font-semibold">
      рідкісних слів уже повернуто у вжиток. Мета — мільйон.
    </span>
  </div>
</section>
