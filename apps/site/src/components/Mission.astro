---
import { GoalProgress } from './GoalProgress';

const lines = [
  'Словники знають сотні тисяч слів. Ми хочемо, щоб їх знали люди.',
  'Мова живе, поки нею говорять. Ми повертаємо їй забуті слова.',
  "Зробити багатство мови не обов'язком, а задоволенням.",
];
---

<section data-th="dark" class="bg-bg text-ink">
  <div class="mx-auto grid max-w-[1280px] grid-cols-[repeat(auto-fit,minmax(min(100%,400px),1fr))] gap-[clamp(36px,5vw,72px)] px-[clamp(16px,4vw,40px)] py-[clamp(56px,8vw,112px)]">
    <h2 class="m-0 origin-left -rotate-5 -skew-x-6 font-word text-[clamp(52px,7.5vw,112px)] leading-[0.95] font-black tracking-[-0.04em] text-red">
      Навіщо
    </h2>
    <div class="flex min-w-0 flex-col gap-[clamp(28px,4vw,44px)]">
      <div class="flex flex-col gap-[26px]">
        {lines.map((line) => (
          <span class="text-[clamp(20px,2.1vw,27px)] leading-[1.35] font-semibold text-pretty">
            {line}
          </span>
        ))}
      </div>
      <div class="flex flex-col gap-4 rounded-3xl border border-line bg-sf p-[clamp(20px,3vw,28px)]">
        <span class="-skew-x-10 self-start bg-red px-2.5 py-[7px] font-word text-[11px] leading-none font-extrabold tracking-[1px] text-coal">
          МЕТА
        </span>
        <span class="font-word text-[clamp(20px,2.2vw,26px)] leading-[1.2] font-black tracking-[-0.02em]">
          Мільйон рідкісних слів, повернутих у вжиток
        </span>
        <GoalProgress client:visible />
        <span class="self-start rounded-md border-[1.5px] border-dashed border-red px-2 py-1.5 text-xs leading-none font-bold text-red">
          ЗАГЛУШКА: демо-число
        </span>
      </div>
    </div>
  </div>
</section>
