---
const card =
  'flex flex-col gap-3.5 rounded-3xl border border-line bg-sf p-6 shadow-[0_6px_0_var(--edge)]';
const label =
  'self-start -skew-x-[10deg] bg-ink px-2.5 py-[7px] font-word text-[11px] leading-none font-extrabold tracking-[1px] text-bg';
const title = 'm-0 font-word text-[22px] leading-[1.15] font-black tracking-[-0.02em]';
const note = 'font-ui text-base leading-[1.45] text-mute';
const tile = 'rounded-[7px] bg-tile shadow-[0_3px_0_var(--edge)]';
const redTile = 'rounded-[7px] bg-red text-coal shadow-[0_3px_0_var(--red-edge)]';
const games = ['Наголос', 'Пари', 'Анаграми', 'Обери правильне', 'На час'];
const intervals = ['1', '3', '7', '30', '90'];
---

<section class="bg-sf2">
  <div class="mx-auto flex max-w-[1280px] flex-col gap-[clamp(36px,5vw,56px)] px-[clamp(16px,4vw,40px)] py-[clamp(56px,8vw,112px)]">
    <h2 class="m-0 max-w-[16ch] origin-left -rotate-3 font-word text-[clamp(36px,4.8vw,68px)] leading-none font-black tracking-[-0.035em] text-balance">
      Мова багатша, ніж ти думаєш.
    </h2>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,270px),1fr))] gap-5">
      <div class={card}>
        <span class={label}>СТРІЧКА</span>
        <h3 class={title}>Стрічка рідкісних слів</h3>
        <span class={note}>Українська, якої не вчили в школі.</span>
      </div>
      <div class={card}>
        <span class={label}>КРОСВОРД</span>
        <h3 class={title}>Щоденний кросворд</h3>
        <span class={note}>Для тих, кому звичайних слів замало.</span>
        <div class="mt-auto flex gap-1">
          {['К', 'Р', 'А', '', ''].map((letter, i) => (
            <span
              class:list={[
                'grid h-[34px] w-[30px] place-items-center font-word text-sm leading-none font-extrabold',
                i === 2 ? redTile : tile,
              ]}
            >
              {letter}
            </span>
          ))}
        </div>
      </div>
      <div class={card}>
        <span class={label}>ІГРИ</span>
        <div class="flex flex-wrap gap-1.5">
          {games.map((game) => (
            <span class="rounded-[10px] bg-sf2 px-[11px] py-[9px] font-word text-xs leading-none font-extrabold">
              {game}
            </span>
          ))}
        </div>
        <span class={note}>Скарби зі словника — щодня в кишені.</span>
      </div>
      <div class={card}>
        <span class={label}>КОЛЕКЦІЇ</span>
        <h3 class={title}>Колекції й обране</h3>
        <span class={note}>
          Збирай слова в колекції, а повторення поверне кожне через 1, 3, 7, 30 і 90 днів.
        </span>
        <div class="mt-auto flex gap-1">
          {intervals.map((days, i) => (
            <span
              class:list={[
                'grid h-9 min-w-[34px] place-items-center rounded-lg px-1.5 font-word text-[13px] leading-none font-extrabold',
                i === intervals.length - 1
                  ? 'bg-red text-coal shadow-[0_3px_0_var(--red-edge)]'
                  : 'bg-tile shadow-[0_3px_0_var(--edge)]',
              ]}
            >
              {days}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
