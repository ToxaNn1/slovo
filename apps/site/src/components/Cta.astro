---
import AppStoreBadge from './AppStoreBadge.astro';
import LetterTiles, { type Tile } from './LetterTiles.astro';
import Mascot from './Mascot.astro';

const tiles: Tile[] = [
  { ch: 'С', tilt: 'rotate(-5deg)' },
  { ch: 'И', tilt: 'translateY(-8px) rotate(3deg)' },
  { ch: 'З', tilt: 'none' },
  { ch: 'И', tilt: 'translateY(-4px) rotate(-4deg)' },
  { ch: 'Г', tilt: 'rotate(4deg)' },
  { ch: 'І', tilt: 'translateY(-12px) rotate(-2deg)', ground: 'coal' },
  { ch: 'Я', tilt: 'rotate(5deg)' },
];
---

<section id="cta" class="relative mt-[clamp(88px,11vw,168px)] overflow-hidden bg-red text-coal">
  <div class="relative mx-auto grid max-w-[1312px] grid-cols-[repeat(auto-fit,minmax(min(100%,480px),1fr))] items-center gap-12 px-[clamp(20px,4vw,56px)] pt-[clamp(72px,9vw,136px)] pb-[clamp(40px,5vw,72px)]">
    <div class="flex flex-col items-start gap-[clamp(28px,3vw,40px)]">
      <LetterTiles
        tiles={tiles}
        class="w-full grid-cols-[repeat(7,minmax(0,64px))]"
        size="text-[clamp(17px,2vw,26px)]"
      />
      <h2 class="m-0 origin-bottom-left [transform:rotate(-4deg)_skewX(-6deg)] font-word text-[clamp(56px,7vw,104px)] leading-[0.88] font-black tracking-[-0.045em]">
        Тримай
        <br />
        слово.
      </h2>
      <AppStoreBadge />
    </div>
    <div class="grid aspect-square w-full max-w-[460px] place-items-center justify-self-center">
      <Mascot state="celebrates" onRed class="w-[78%]" />
    </div>
  </div>
  <div
    aria-hidden="true"
    class="h-[clamp(56px,8vw,120px)] bg-coal [clip-path:polygon(0_100%,100%_0,100%_100%)]"
  ></div>
</section>
