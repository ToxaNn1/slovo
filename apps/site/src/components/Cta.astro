---
import Mascot from './Mascot.astro';

const tiles = ['С', 'И', 'З', 'И', 'Г', 'І', 'Я'];
const tile =
  'grid h-[52px] w-11 place-items-center rounded-[10px] font-word text-[22px] leading-none font-black';
---

<section id="cta" class="relative overflow-hidden bg-red text-coal">
  <div class="absolute inset-0 bg-coal [clip-path:polygon(0_0,100%_0,100%_14%,0_30%)]"></div>
  <div class="relative mx-auto grid max-w-[1280px] grid-cols-[repeat(auto-fit,minmax(min(100%,400px),1fr))] items-center gap-[clamp(40px,6vw,72px)] px-[clamp(16px,4vw,40px)] pt-[clamp(120px,14vw,190px)] pb-[clamp(64px,8vw,112px)]">
    <div class="flex flex-col items-start gap-9">
      <h2 class="m-0 origin-bottom-left -rotate-5 -skew-x-6 pt-[0.15em] pb-[0.1em] font-word text-[clamp(54px,8vw,124px)] leading-[0.92] font-black tracking-[-0.04em]">
        Тримай
        <br />
        слово.
      </h2>
      <a
        href="#"
        class="inline-flex min-h-16 items-center rounded-[14px] bg-coal px-[30px] font-word text-[17px] leading-none font-extrabold text-cream no-underline shadow-[0_6px_0_var(--color-shadow-red)] transition-[transform,box-shadow] duration-[120ms] hover:translate-y-0.5 hover:text-cream hover:shadow-[0_4px_0_var(--color-shadow-red)] active:translate-y-1.5 active:shadow-[0_0_0_var(--color-shadow-red)]"
      >
        Завантажити в App Store
      </a>
    </div>
    <div class="flex flex-col items-center gap-7">
      <div class="-rotate-10">
        <Mascot state="celebrates" onRed class="aspect-[4/3] w-[180px] min-[1000px]:w-[260px]" />
      </div>
      <div class="flex -rotate-4 flex-wrap justify-center gap-1.5">
        {tiles.map((letter, i) =>
          i === 4 ? (
            <span
              class:list={[tile, 'bg-coal text-cream shadow-[0_5px_0_var(--color-shadow-red)]']}
            >
              {letter}
            </span>
          ) : (
            <span class:list={[tile, 'bg-cream shadow-[0_5px_0_var(--color-coal)]']}>{letter}</span>
          ),
        )}
      </div>
    </div>
  </div>
</section>
